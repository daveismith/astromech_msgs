# Stop whatever the Magic Panel is running. Stopping an idle panel is not an error.
uint8 STOP_BLANK=0
uint8 STOP_FREEZE=1
uint8 PRIORITY_OVERRIDE=200  # this and above, or 0, are never refused for a hold

uint8   mode
uint8   priority            # 1..199: refused while the panel is held; see PRIORITY_OVERRIDE
---
bool    accepted            # true even when nothing was running
string  reason
