uint8 PRIORITY_OVERRIDE=200  # this and above, or 0, are never refused for a hold
string  surface         # a surface, or "all"
string  effect          # an effect, or a clip for the surface's target
uint32  rgb             # 0xRRGGBB; 0: the effect's or clip's own colour
uint8   speed           # 1..9; 0: 5
uint32  duration_ms     # 0: until stopped, or the effect ends by itself
string  owner           # who is asking, for the state topics; up to 31 bytes, may be empty
uint8   priority        # 1..199: refused while a display it touches is held; see PRIORITY_OVERRIDE
---
bool    accepted
string  reason          # empty when accepted
