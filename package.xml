<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astromech_msgs</name>
  <version>1.0.0</version>
  <description>
    Interfaces for an astromech droid's servo controllers: a controller-agnostic servo
    record and the services that list, configure and raw-move one. Versioned with the
    astromech URDF extension namespace (https://astromech.co/urdf/1.0).
  </description>
  <maintainer email="1734595+daveismith@users.noreply.github.com">David Smith</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
